lint:
  uv run pre-commit run --all-files

lint-update:
  uv run pre-commit autoupdate

test:
  uv run pytest --cache-clear --verbose --cov=blackfish

coverage:
  #!/usr/bin/env bash
  set -euo pipefail
  uv run coverage xml -o - | uv run genbadge coverage --local -i - -o docs/assets/img/coverage.svg

docs:
  uv run zensical build

docs-serve:
  uv run zensical serve --open
